# Puerto del servidor (opcional en Next.js, por defecto 3000)
PORT=3000

# Base de datos (PostgreSQL)
# Ejemplo: postgres://usuario:password@localhost:5432/andres_nutricion
DATABASE_URL=postgres://usuario:password@host:5432/db_name

# Google Calendar API (Service Account)
GOOGLE_CALENDAR_CLIENT_EMAIL=tu_service_account@project-id.iam.gserviceaccount.com
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTuLlavePrivadaAca\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=tu_calendar_id@group.calendar.google.com

# Pasarela de Pagos (Payphone Ecuador)
# Token secreto de servidor para confirmar pagos vía API (NUNCA exponer al cliente)
PAYPHONE_TOKEN=tu_bearer_token_de_desarrollador_privado_payphone
# Token público para inicializar la cajita en el navegador si aplica
NEXT_PUBLIC_PAYPHONE_TOKEN=tu_token_publico_cajita_payphone
PAYPHONE_STORE_ID=tu_store_id_opcional

# Email Transaccional (Resend)
RESEND_API_KEY=re_tu_resend_api_key_aqui

# Seguridad y Sesiones (JWT / Auth)
JWT_SECRET=un_secreto_super_seguro_y_largo_de_32_caracteres_minimo
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu_nextauth_secret
CRON_SECRET=tu_cron_secret_para_tareas_programadas
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_recaptcha_site_key
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key

# Configuración del Admin (CMS)
ADMIN_PASSWORD=genera_una_contrasena_maestra_fuerte_aqui
ADMIN_EMAIL=admin@ejemplo.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Enlaces para citas
MEET_LINK=https://meet.google.com/tu-codigo-meet
NEXT_PUBLIC_MEET_LINK=https://meet.google.com/tu-codigo-meet
CLINIC_LOCATION_LINK=https://maps.app.goo.gl/1r8denLgxkjWyQiC8
NEXT_PUBLIC_CLINIC_LOCATION_LINK=https://maps.app.goo.gl/1r8denLgxkjWyQiC8


