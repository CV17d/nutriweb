# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# credentials & service accounts
*.pem
*service-account*.json
src/config/*.json

# debug & scratch scripts
scratch/
test-*.js
check_*.js
restore-data.js
add_rating.js
seed-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

